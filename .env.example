# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交）
# MongoDB Atlas 连接串，形如：
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
NUXT_MONGODB_URI=

# 小米 MiMo 语音合成 API Key（用于 /tts 页面，形如 sk-xxxxxxxx）
# 仅服务端使用，不会打包进浏览器；在 https://platform.xiaomimimo.com 控制台获取
NUXT_MIMO_API_KEY=

# 登录会话 JWT 的签名密钥（HS256），至少 32 位随机字符
# 生成：openssl rand -hex 32
# 生产环境未配置会直接拒绝登录；开发环境有内置兜底值
NUXT_JWT_SECRET=
